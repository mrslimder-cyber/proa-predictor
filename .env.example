# Copia este archivo a .env y rellena lo que necesites.
# Si no defines DATABASE_URL, se usa SQLite local en data/proa.db (por defecto, ideal para empezar).

# Ejemplo para Supabase/Postgres (cuando pases a producción con Vercel):
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/nombre_bd
